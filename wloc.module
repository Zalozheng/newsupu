#!url=https://raw.githubusercontent.com/Zalozheng/newsupu/main/wloc.module
#!name=Apple WLOC 定位修改
#!desc=Apple 网络定位修改（纽约 Richmond Hill）
#!category=Tools

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/Zalozheng/newsupu/main/wloc.js,argument=longitude=-73.828052&latitude=40.694154&accuracy=25&randomRadius=0&logLevel=info

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
